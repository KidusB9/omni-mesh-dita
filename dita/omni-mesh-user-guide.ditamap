<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE bookmap PUBLIC "-//OASIS//DTD DITA BookMap//EN" "bookmap.dtd">
<!--
  OMNI user guide. One source, two editions:
    user edition       filters/user.ditaval       (drops audience="technical")
    technical edition  filters/technical.ditaval  (adds the technical chapter)
-->
<bookmap id="omni-user-guide" xml:lang="en-US">
  <booktitle>
    <mainbooktitle>OMNI</mainbooktitle>
    <booktitlealt audience="user">User Guide</booktitlealt>
    <booktitlealt audience="technical">User Guide, Technical Edition</booktitlealt>
  </booktitle>

  <bookmeta>
    <critdates>
      <created date="2026-10-27"/>
      <revised modified="2026-10-27"/>
    </critdates>
    <prodinfo>
      <prodname>OMNI</prodname>
      <vrmlist><vrm version="2.0"/></vrmlist>
      <platform>iPhone</platform>
    </prodinfo>
    <bookrights>
      <copyrfirst><year>2026</year></copyrfirst>
      <bookowner><person>Kidus Berhanu</person></bookowner>
    </bookrights>
    <data name="tagline" value="Meet the people around you who share your interests. No internet, no signal, no account."/>
  </bookmeta>

  <frontmatter>
    <mapref href="keys.ditamap" processing-role="resource-only"/>
    <booklists>
      <toc/>
    </booklists>
    <preface href="concepts/about-this-guide.dita"/>
  </frontmatter>

  <chapter href="concepts/c-what-is-omni.dita">
